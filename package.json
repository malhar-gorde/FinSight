{
  "name": "finsight",
  "version": "1.0.0",
  "private": true,
  "description": "FinSight — personal finance and investment dashboard (Next.js + FastAPI)",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:api-dev\" \"npm:next-dev\"",
    "next-dev": "next dev",
    "api-dev": "python -m uvicorn api.index:app --reload --port 8000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.65.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3"
  }
}
